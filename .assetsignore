# Files that must NOT be uploaded as public static assets.
# node_modules is created by `npm install` at build time and contains
# large binaries (e.g. workerd) that exceed Cloudflare's 25 MiB limit.
node_modules
.git
.wrangler
src
audit
client-sites-starter
*.md
package.json
package-lock.json
tasks.db
wrangler.jsonc
.assetsignore
.gitignore

# Internal tooling and lead data — must never be served (WEB-497).
# tools/publication-crawler/fixtures/web400-smoke-50.csv was live at
# https://webuildco.com.au/tools/publication-crawler/fixtures/web400-smoke-50.csv
# (HTTP 200, 50 named contacts) until this entry was added.
tools/publication-crawler
tools/suppression
runs
