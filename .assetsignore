# Files that must NOT be uploaded as public static assets.
# node_modules is created by `npm install` at build time and contains
# large binaries (e.g. workerd) that exceed Cloudflare's 25 MiB limit.
node_modules
.git
.wrangler
src
audit
client-sites-starter
*.md
package.json
package-lock.json
tasks.db
wrangler.jsonc
.assetsignore
.gitignore

# Internal tooling and lead data — must never be served (WEB-497, WEB-514).
# A crawler fixture under tools/ was reachable as a static asset before these
# entries existed. Tooling directories stay out of the deployed asset set.
tools/publication-crawler
tools/suppression
runs
